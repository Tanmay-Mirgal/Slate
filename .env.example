# Copy to .env.local and fill in. Never commit real values.

# ── Convex (realtime database) ────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Clerk (authentication) ────────────────────────────────────────────────────
# The Clerk JWT template named "convex" must exist (see convex/auth.config.ts).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── AI: NVIDIA NIM (free hosted models) ───────────────────────────────────────
# Key: https://build.nvidia.com  ->  profile  ->  API Keys. Leave empty to disable AI (templates still work).
NVIDIA_API_KEY=
# Optional model chain, first = preferred (defaults shown). `npm run ai:check` tests them against your key.
# NVIDIA_MODELS=nvidia/nemotron-3-super-120b-a12b,mistralai/mistral-large-2-instruct,nvidia/llama-3.1-nemotron-70b-instruct,nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI generations per user per hour (default 40)
# AI_RATE_LIMIT_PER_HOUR=40

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Invite emails (SMTP, optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
