# Copy to .env.local and fill in. Never commit real values.

# ── MongoDB (database) ────────────────────────────────────────────────────────
# Atlas: Database -> Connect -> Drivers. The database name at the end of the URI is the one used.
# Also allow your IP (and your host's) under Network Access.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/slate"

# ── Realtime (WebSocket server) ───────────────────────────────────────────────
# Live board changes, writes and cursors go over WebSockets. `npm run dev` starts the server next to the app;
# in production run `npm run realtime` as its own service (a serverless host can't hold WebSockets open) and
# point the browsers at it. Without it the app still works, on HTTP polling. "off" forces polling.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000
REALTIME_PORT=4000
# Optional hardening for the realtime server:
# REALTIME_ALLOWED_ORIGINS=https://app.example.com
# REALTIME_TRUST_PROXY=1
# CLERK_JWT_KEY=   (verify sign-in tokens without calling Clerk)

# ── Clerk (authentication) ────────────────────────────────────────────────────
# Keep MongoDB in step with Clerk: Clerk Dashboard -> Webhooks -> add an endpoint
# https://<your-domain>/api/webhooks/clerk for user.created, user.updated and user.deleted, and paste its
# signing secret below. (Users are also created in MongoDB the first time they sign in, so a missing or
# late webhook never blocks anyone; run `npm run clerk:sync` to backfill everybody at any time.)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── AI: NVIDIA NIM (free hosted models) ───────────────────────────────────────
# Key: https://build.nvidia.com  ->  profile  ->  API Keys. Leave empty to disable AI (templates still work).
NVIDIA_API_KEY=
# Optional model chain, first = preferred (defaults shown). `npm run ai:check` tests them against your key.
# NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI generations per user per hour (default 40)
# AI_RATE_LIMIT_PER_HOUR=40

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# Keys: Razorpay Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys until you go live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: Dashboard -> Webhooks -> add https://<your-domain>/api/billing/razorpay/webhook with the
# events subscription.activated, subscription.charged, subscription.cancelled (and optionally
# subscription.halted, subscription.completed). Paste the secret you choose here.
RAZORPAY_WEBHOOK_SECRET=
# Optional recurring-billing plan ids (Dashboard -> Subscriptions -> Plans). When a plan id is missing,
# checkout falls back to a one-time order for the first period, which is handy for testing.
# Create the plans at: Pro 999 INR monthly / 8999 INR yearly, Team 1999 INR monthly / 17999 INR yearly (per seat).
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_TEAM_MONTHLY=
RAZORPAY_PLAN_TEAM_ANNUAL=

# ── Invite emails (SMTP, optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# ── SEO ───────────────────────────────────────────────────────────────────────
# Canonical origin used in canonical URLs, the sitemap, robots.txt and structured data. Defaults to production.
# NEXT_PUBLIC_SITE_URL=https://slate.tanmaymirgal.dev
# Search Console -> Add property -> URL prefix -> HTML tag: paste only the content="..." value. Bing Webmaster Tools likewise.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
