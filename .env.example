# Copy to .env.local and fill in. Never commit real values.

# ── Convex (realtime database) ────────────────────────────────────────────────
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# ── Clerk (authentication) ────────────────────────────────────────────────────
# The Clerk JWT template named "convex" must exist (see convex/auth.config.ts).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── AI: NVIDIA NIM (free hosted models) ───────────────────────────────────────
# Key: https://build.nvidia.com  ->  profile  ->  API Keys. Leave empty to disable AI (templates still work).
NVIDIA_API_KEY=
# Optional model chain, first = preferred (defaults shown). `npm run ai:check` tests them against your key.
# NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3.5-super-vl-120b-a12b,nvidia/nemotron-3-super-120b-a12b
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# AI generations per user per hour (default 40)
# AI_RATE_LIMIT_PER_HOUR=40

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# Keys: Razorpay Dashboard -> Account & Settings -> API Keys. Use rzp_test_ keys until you go live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook: Dashboard -> Webhooks -> add https://<your-domain>/api/billing/razorpay/webhook with the
# events subscription.activated, subscription.charged, subscription.cancelled (and optionally
# subscription.halted, subscription.completed). Paste the secret you choose here.
RAZORPAY_WEBHOOK_SECRET=
# Shared secret that lets this server change plans in Convex. Any random string of 16+ characters.
# Set the SAME value in the Convex dashboard (Settings -> Environment Variables) as BILLING_SYNC_SECRET.
BILLING_SYNC_SECRET=
# Optional recurring-billing plan ids (Dashboard -> Subscriptions -> Plans). When a plan id is missing,
# checkout falls back to a one-time order for the first period, which is handy for testing.
# Create the plans at: Pro 999 INR monthly / 8999 INR yearly, Team 1999 INR monthly / 17999 INR yearly (per seat).
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_TEAM_MONTHLY=
RAZORPAY_PLAN_TEAM_ANNUAL=

# ── Invite emails (SMTP, optional) ────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
